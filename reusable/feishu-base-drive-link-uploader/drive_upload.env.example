# 飞书多维表格附件 -> 云盘链接回填器
# 复制为 drive_upload.env 后填写。不要把真实 token 提交进版本库。

# 目标多维表格与表
BASE_TOKEN="你的_base_token"
TABLE_ID="你的_table_id"

# 上传文件所在的飞书租户域名；示例：transsioner.feishu.cn
FEISHU_DOMAIN="你的租户.feishu.cn"

# 云盘目标文件夹。先用 lark-cli drive +create-folder 建文件夹并取 token。
DRIVE_FOLDER_TOKEN="你的_drive_folder_token"

# 大多数场景用 user；此身份需有该 Base、云盘文件夹的读写权限。
UPLOAD_IDENTITY="user"

# tenant_readable = 组织内拿到链接即可查看；按公司安全政策调整。
LINK_SHARE="tenant_readable"

# 下面四项必须按新项目自己的 field-list 结果填写。
# 左边=附件字段 field_id，右边=保存云盘链接的文本字段名称。
ATTACHMENT_LINK_MAP='{"你的M附件字段ID":"云盘链接M","你的L附件字段ID":"云盘链接L","你的S附件字段ID":"云盘链接S"}'

# --sweep 用这一对字段识别“附件存在但链接没填”的记录。
SWEEP_SOURCE_FIELD_ID="你的M附件字段ID"
SWEEP_LINK_FIELD="云盘链接M"

# 可选：若你的发送工作流需要按大小分支，填复选框字段名。
# 任一 BIGCHECK_FIELD_IDS 中的文件 >= BIG_FILE_MB 就会勾选。
BIG_FILE_FIELD="是否大文件"
BIGCHECK_FIELD_IDS='["你的M附件字段ID","你的L附件字段ID","你的S附件字段ID"]'
BIG_FILE_MB="28"

# 工作目录必须是脚本目录内的相对路径，适配受限 VM 的 lark-cli 文件路径规则。
WORK_DIR=".drive_upload_work"
LOG_FILE="uploader.log"
LOCK_TTL_SECONDS="900"
LARK_CLI="lark-cli"

# 如果 VM 不该走本机代理，设为 1；否则删除这一行。
export LARK_CLI_NO_PROXY=1
